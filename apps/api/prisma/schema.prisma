generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  password    String
  name        String?
  role        Role      @default(EDITOR)
  articles    Article[]
  invitesSent Invite[]
  createdAt   DateTime  @default(now())
}

enum Role {
  SUPER_ADMIN
  EDITOR
}

model Invite {
  id        String    @id @default(cuid())
  email     String
  token     String    @unique
  role      Role      @default(EDITOR)
  invitedBy String
  inviter   User      @relation(fields: [invitedBy], references: [id])
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Article {
  id            String                       @id @default(cuid())
  title         String
  slug          String                       @unique
  summary       String?
  content       String
  feature       String?
  productArea   ProductArea?
  difficulty    Difficulty?
  sgenUrl       String?
  status        ArticleStatus                @default(DRAFT)
  reviewedAt    DateTime?
  reviewedBy    String?
  steps         Step[]
  tags          Tag[]                        @relation("ArticleTags")
  category      Category?                    @relation(fields: [categoryId], references: [id])
  categoryId    String?
  prerequisites Article[]                    @relation("Prerequisites")
  requiredBy    Article[]                    @relation("Prerequisites")
  relatedTo     Article[]                    @relation("RelatedArticles")
  relatedFrom   Article[]                    @relation("RelatedArticles")
  embedding     Unsupported("vector")?
  embeddingModel String?
  duplicateOf    String?
  duplicateScore Float?
  author        User                         @relation(fields: [authorId], references: [id])
  authorId      String
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt

  @@index([status])
  @@index([productArea])
  @@index([embeddingModel])
  @@index([duplicateOf])
}

enum ProductArea {
  SG_CORE
  SG_MODULES
  SG_DASHBOARD
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Step {
  id        String  @id @default(cuid())
  order     Int
  title     String
  content   String
  imageUrl  String?
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId String

  @@index([articleId, order])
}

model Tag {
  id       String    @id @default(cuid())
  name     String    @unique
  articles Article[] @relation("ArticleTags")
}

model Category {
  id       String     @id @default(cuid())
  name     String
  slug     String     @unique
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  parentId String?
  children Category[] @relation("CategoryHierarchy")
  articles Article[]
}

model ApiKey {
  id         String    @id @default(cuid())
  name       String
  hashedKey  String    @unique
  prefix     String
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
}

model BotQuery {
  id         String   @id @default(cuid())
  question   String
  matchedId  String?
  confidence Float?
  helpful    Boolean?
  apiKeyId   String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model UploadJob {
  id          String    @id @default(cuid())
  status      JobStatus @default(PENDING)
  total       Int
  completed   Int       @default(0)
  failed      Int       @default(0)
  errors      Json?
  createdBy   String
  createdAt   DateTime  @default(now())
  completedAt DateTime?
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
